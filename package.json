{
  "name": "kolkata-local-guide",
  "version": "1.0.0",
  "description": "AI-powered local guide for Kolkata - helps with food, hangouts, and transport recommendations",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-data",
    "copy-data": "xcopy src\\data\\*.json dist\\data\\ /Y /I",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "demo": "npm run build && npm start"
  },
  "keywords": ["kolkata", "local-guide", "ai", "recommendations", "bengal"],
  "author": "AI for Bharat Challenge Participant",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}